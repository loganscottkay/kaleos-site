# Copy this file to .env.local to run the site locally.
# Every value here is a placeholder. With placeholders the site runs fully;
# the lead form, the chat widget, and the roadmap question box show a
# friendly "not configured" message instead of sending anything.
# Real values live in Vercel (Logan manages them). Never commit .env.local.

# Resend: sends the lead-form email to logan@kaleoshq.com (from leads@kaleoshq.com).
RESEND_API_KEY=

# Airtable: writes each lead-form submission as a row in the "Kaleos HQ Leads" base, table "Leads".
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# OpenAI: powers the "Talk to Logan" chat widget (GPT-4o via /api/chat).
OPENAI_API_KEY=
